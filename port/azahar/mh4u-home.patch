+package org.citra.citra_emu;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.Intent;
+import android.content.res.ColorStateList;
+import android.database.Cursor;
+import android.graphics.Color;
+import android.graphics.Typeface;
+import android.net.Uri;
+import android.os.Bundle;
+import android.provider.OpenableColumns;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.ProgressBar;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.core.content.FileProvider;
+
+import org.citra.citra_emu.model.Game;
+import org.citra.citra_emu.utils.GameHelper;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+
+/**
+ * MH4U home screen. Imports the player's own game file into private app storage and remembers it.
+ * SAF grants access only to the file selected by the player; no broad storage permission is needed.
+ */
+public final class MH4UHomeActivity extends Activity {
+    private static final int REQUEST_GAME_FILE = 4104;
+    private static final String PREFS = "mh4u_home";
+    private static final String PREF_GAME = "imported_game";
+    private TextView status;
+    private Button launchButton;
+    private Button importButton;
+    private ProgressBar progress;
+    private File gameFile;
+
+    private int dp(int value) {
+        return Math.round(value * getResources().getDisplayMetrics().density);
+    }
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        File games = new File(getFilesDir(), "games");
+        if (!games.exists()) games.mkdirs();
+        String saved = getSharedPreferences(PREFS, MODE_PRIVATE).getString(PREF_GAME, "");
+        if (!saved.isEmpty()) {
+            File candidate = new File(saved);
+            if (candidate.isFile() && candidate.length() > 0) gameFile = candidate;
+        }
+        buildUi();
+        refreshStatus();
+    }
+
+    private void buildUi() {
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setGravity(Gravity.CENTER_VERTICAL);
+        root.setPadding(dp(28), dp(24), dp(28), dp(24));
+        root.setBackgroundColor(Color.rgb(12, 12, 14));
+
+        TextView title = new TextView(this);
+        title.setText("MONSTER HUNTER\n4 ULTIMATE");
+        title.setTextColor(Color.rgb(246, 239, 218));
+        title.setTextSize(30);
+        title.setTypeface(Typeface.DEFAULT_BOLD);
+        title.setGravity(Gravity.CENTER);
+        root.addView(title, matchWrap());
+
+        TextView subtitle = new TextView(this);
+        subtitle.setText("HUNTER'S GUILD  •  USA v1.3.0");
+        subtitle.setTextColor(Color.rgb(190, 151, 82));
+        subtitle.setTextSize(14);
+        subtitle.setGravity(Gravity.CENTER);
+        LinearLayout.LayoutParams subtitleParams = matchWrap();
+        subtitleParams.topMargin = dp(10);
+        root.addView(subtitle, subtitleParams);
+
+        status = new TextView(this);
+        status.setTextColor(Color.rgb(239, 230, 205));
+        status.setTextSize(14);
+        status.setPadding(dp(18), dp(18), dp(18), dp(18));
+        status.setBackgroundColor(Color.rgb(30, 24, 20));
+        status.setGravity(Gravity.CENTER);
+        status.setLineSpacing(dp(4), 1.0f);
+        LinearLayout.LayoutParams statusParams = matchWrap();
+        statusParams.topMargin = dp(24);
+        root.addView(status, statusParams);
+
+        progress = new ProgressBar(this, null, android.R.attr.progressBarStyleHorizontal);
+        progress.setVisibility(View.GONE);
+        LinearLayout.LayoutParams progressParams = matchWrap();
+        progressParams.topMargin = dp(12);
+        root.addView(progress, progressParams);
+
+        importButton = makeButton("SETUP  •  IMPORT GAME", Color.rgb(55, 42, 31));
+        importButton.setOnClickListener(view -> chooseGame());
+        LinearLayout.LayoutParams importParams = matchWrap();
+        importParams.topMargin = dp(20);
+        root.addView(importButton, importParams);
+
+        launchButton = makeButton("PLAY  •  LAUNCH GAME", Color.rgb(157, 24, 42));
+        launchButton.setOnClickListener(view -> launchGame());
+        LinearLayout.LayoutParams launchParams = matchWrap();
+        launchParams.topMargin = dp(10);
+        root.addView(launchButton, launchParams);
+
+        Button settings = makeButton("SETTINGS  •  OPTIONS", Color.rgb(55, 42, 31));
+        settings.setOnClickListener(view -> showSettings());
+        LinearLayout.LayoutParams settingsParams = matchWrap();
+        settingsParams.topMargin = dp(10);
+        root.addView(settings, settingsParams);
+
+        Button about = makeButton("ABOUT  •  PORT INFO", Color.rgb(38, 35, 32));
+        about.setOnClickListener(view -> showAbout());
+        LinearLayout.LayoutParams aboutParams = matchWrap();
+        aboutParams.topMargin = dp(8);
+        root.addView(about, aboutParams);
+        Button builderProbe = makeButton("DEVELOPER  •  TEST ANDROID BUILDER", Color.rgb(38, 55, 48));
        builderProbe.setOnClickListener(view -> runBuilderProbe());
        LinearLayout.LayoutParams probeParams = matchWrap();
        probeParams.topMargin = dp(8);
        root.addView(builderProbe, probeParams);
        setContentView(root);
+    }
+
+    private LinearLayout.LayoutParams matchWrap() {
+        return new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT);
+    }
+
+    private Button makeButton(String text, int color) {
+        Button button = new Button(this);
+        button.setText(text);
+        button.setTextColor(Color.rgb(255, 255, 255));
+        button.setBackgroundTintList(ColorStateList.valueOf(color));
+        return button;
+    }
+
+    private void refreshStatus() {
+        if (gameFile != null && gameFile.isFile() && gameFile.length() > 0) {
+            status.setText("HUNTER STATUS  •  GAME READY\n\n" + gameFile.getName()
+                    + "\n" + formatBytes(gameFile.length())
+                    + "\n\nImported into private app storage. You can launch without selecting it again.");
+            launchButton.setEnabled(true);
+            launchButton.setAlpha(1f);
+            importButton.setText("CHANGE GAME  •  IMPORT AGAIN");
+        } else {
+            gameFile = null;
+            status.setText("FIRST-TIME SETUP REQUIRED\n\n1. Tap IMPORT GAME\n2. Choose your own MH4U .3ds file\n"
+                    + "3. Wait for import to finish\n\nThe app remembers the imported file.");
+            launchButton.setEnabled(false);
+            launchButton.setAlpha(0.55f);
+            importButton.setText("SETUP  •  IMPORT GAME");
+        }
+    }
+
+    private void chooseGame() {
+        Intent pick = new Intent(Intent.ACTION_OPEN_DOCUMENT);
+        pick.addCategory(Intent.CATEGORY_OPENABLE);
+        pick.setType("*/*");
+        startActivityForResult(pick, REQUEST_GAME_FILE);
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (requestCode != REQUEST_GAME_FILE || resultCode != RESULT_OK || data == null) return;
+        Uri uri = data.getData();
+        if (uri == null) return;
+        importGame(uri);
+    }
+
+    private void importGame(Uri uri) {
+        final String displayName = queryDisplayName(uri);
+        final String safeName = sanitizeName(displayName.isEmpty() ? "MH4U.3ds" : displayName);
+        importButton.setEnabled(false);
+        launchButton.setEnabled(false);
+        progress.setVisibility(View.VISIBLE);
+        progress.setIndeterminate(true);
+        status.setText("IMPORTING GAME\n\n" + safeName + "\nPlease keep the app open.");
+
+        new Thread(() -> {
+            File games = new File(getFilesDir(), "games");
+            File temp = new File(games, safeName + ".importing");
+            File target = new File(games, safeName);
+            boolean ok = false;
+            String error = "";
+            try (InputStream input = getContentResolver().openInputStream(uri);
+                 OutputStream output = new FileOutputStream(temp)) {
+                if (input == null) throw new java.io.IOException("Cannot open selected file.");
+                byte[] buffer = new byte[1024 * 1024];
+                int count;
+                while ((count = input.read(buffer)) != -1) output.write(buffer, 0, count);
+                output.flush();
+                if (temp.length() == 0) throw new java.io.IOException("Selected file is empty.");
+                if (target.exists() && !target.delete()) throw new java.io.IOException("Cannot replace old import.");
+                if (!temp.renameTo(target)) throw new java.io.IOException("Cannot finalize imported file.");
+                ok = true;
+            } catch (Exception e) {
+                error = e.getMessage() == null ? e.getClass().getSimpleName() : e.getMessage();
+                temp.delete();
+            }
+            final boolean imported = ok;
+            final String message = error;
+            runOnUiThread(() -> {
+                progress.setVisibility(View.GONE);
+                importButton.setEnabled(true);
+                if (imported) {
+                    gameFile = target;
+                    getSharedPreferences(PREFS, MODE_PRIVATE).edit().putString(PREF_GAME, target.getAbsolutePath()).apply();
+                    refreshStatus();
+                    Toast.makeText(this, "Game imported and saved.", Toast.LENGTH_LONG).show();
+                } else {
+                    refreshStatus();
+                    status.setText("IMPORT FAILED\n\n" + message + "\nPlease check free storage and try again.");
+                    Toast.makeText(this, "Import failed: " + message, Toast.LENGTH_LONG).show();
+                }
+            });
+        }, "MH4U-Game-Import").start();
+    }
+
+    private String queryDisplayName(Uri uri) {
+        try (Cursor cursor = getContentResolver().query(uri, null, null, null, null)) {
+            if (cursor != null && cursor.moveToFirst()) {
+                int index = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME);
+                if (index >= 0) return cursor.getString(index);
+            }
+        } catch (Exception ignored) { }
+        return "MH4U.3ds";
+    }
+
+    private String sanitizeName(String name) {
+        String safe = name.replaceAll("[^A-Za-z0-9._-]", "_");
+        if (safe.length() > 100) safe = safe.substring(safe.length() - 100);
+        if (!safe.toLowerCase(java.util.Locale.ROOT).endsWith(".3ds")
+                && !safe.toLowerCase(java.util.Locale.ROOT).endsWith(".cci")
+                && !safe.toLowerCase(java.util.Locale.ROOT).endsWith(".cxi")) safe += ".3ds";
+        return safe;
+    }
+
+    private String formatBytes(long bytes) {
+        return String.format(java.util.Locale.US, "%.2f GB", bytes / (1024.0 * 1024 * 1024));
+    }
+
+    private void showSettings() {
+        String[] options = {
+                "Swap top and bottom screens",
+                "Show touch controls overlay",
+                "Haptic feedback"
+        };
+        android.content.SharedPreferences prefs =
+                androidx.preference.PreferenceManager.getDefaultSharedPreferences(getApplicationContext());
+        boolean[] checked = {
+                prefs.getBoolean("EmulationMenuSettings_SwapScreens", false),
+                prefs.getBoolean("EmulationMenuSettings_ShowOverlay", true),
+                prefs.getBoolean("EmulationMenuSettings_HapticFeedback", true)
+        };
+        new AlertDialog.Builder(this)
+                .setTitle("MH4U SETTINGS")
+                .setMultiChoiceItems(options, checked, (dialog, which, isChecked) -> {
+                    String key;
+                    if (which == 0) key = "EmulationMenuSettings_SwapScreens";
+                    else if (which == 1) key = "EmulationMenuSettings_ShowOverlay";
+                    else key = "EmulationMenuSettings_HapticFeedback";
+                    prefs.edit().putBoolean(key, isChecked).apply();
+                })
+                .setMessage("These options are saved on this device. Graphics quality and controller mapping require a separate native settings integration.")
+                .setPositiveButton("DONE", null)
+                .setNeutralButton("CHANGE GAME", (dialog, which) -> chooseGame())
+                .show();
+    }
+
+    private void showAbout() {
+        new AlertDialog.Builder(this)
+                .setTitle("ABOUT MH4U ANDROID PORT")
+                .setMessage("Monster Hunter 4 Ultimate • USA v1.3.0\n\n"
+                        + "Android native launcher with Azahar 3DS backend.\n"
+                        + "The game image is supplied by the user and is not bundled in this APK.\n\n"
+                        + "Build status does not guarantee gameplay; test on your device.")
+                .setPositiveButton("OK", null)
+                .show();
+    }
+
+    private void runBuilderProbe() {
        File executable = new File(getApplicationInfo().nativeLibraryDir,
                "libmh4u_builder_probe.so");
        if (!executable.isFile() || !executable.canExecute()) {
            new AlertDialog.Builder(this)
                    .setTitle("ANDROID BUILDER PROBE")
                    .setMessage("Probe executable is missing or not executable:\\n"
                            + executable.getAbsolutePath())
                    .setPositiveButton("OK", null)
                    .show();
            return;
        }

        new Thread(() -> {
            StringBuilder output = new StringBuilder();
            int exitCode = -1;
            try {
                Process process = new ProcessBuilder(executable.getAbsolutePath())
                        .redirectErrorStream(true)
                        .start();
                try (java.io.BufferedReader reader = new java.io.BufferedReader(
                        new java.io.InputStreamReader(process.getInputStream()))) {
                    String line;
                    while ((line = reader.readLine()) != null) output.append(line).append('\\n');
                }
                exitCode = process.waitFor();
            } catch (Exception e) {
                output.append(e.getClass().getSimpleName()).append(": ")
                        .append(e.getMessage());
            }
            final int resultCode = exitCode;
            final String resultText = output.toString();
            runOnUiThread(() -> new AlertDialog.Builder(this)
                    .setTitle(resultCode == 0 ? "EXECUTION PROBE PASSED" : "EXECUTION PROBE FAILED")
                    .setMessage("Exit code: " + resultCode + "\\n\\n" + resultText)
                    .setPositiveButton("OK", null)
                    .show());
        }, "MH4U-Builder-Probe").start();
    }

    private void launchGame() {
+        if (gameFile == null || !gameFile.isFile() || gameFile.length() == 0) {
+            gameFile = null;
+            refreshStatus();
+            Toast.makeText(this, "Import the game file first.", Toast.LENGTH_SHORT).show();
+            return;
+        }
+        try {
+            // Build the same Game model Azahar uses for its own game-library launch flow.
+            Game game = GameHelper.INSTANCE.getGame(
+                    Uri.fromFile(gameFile),
+                    false,
+                    false,
+                    Game.MediaType.GAME_CARD);
+            if (!game.getValid()) {
+                Toast.makeText(this, "Azahar could not read this game file.", Toast.LENGTH_LONG).show();
+                return;
+            }
+
+            // EmulationActivity expects the Parcelable under the exact key "game".
+            Intent launch = new Intent(this,
+                    org.citra.citra_emu.activities.EmulationActivity.class);
+            launch.putExtra("game", game);
+            startActivity(launch);
+        } catch (Exception e) {
+            Toast.makeText(this, "Could not launch game: " + e.getMessage(), Toast.LENGTH_LONG).show();
+        }
+    }
+}
