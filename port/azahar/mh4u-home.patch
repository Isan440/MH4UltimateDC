+package org.citra.citra_emu;
+
+import android.app.Activity;
+import android.content.Intent;
+import androidx.activity.result.ActivityResultLauncher;
+import androidx.activity.result.contract.ActivityResultContracts;
+import android.graphics.Color;
+import android.graphics.Typeface;
+import android.os.Bundle;
+import android.view.Gravity;
+import android.view.ViewGroup;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+/**
+ * First integrated MH4U home screen.
+ *
+ * This activity lives in the Azahar Android app module, so it is packaged in the same APK as
+ * libcitra-android.so and the MH4U backend. It deliberately delegates game selection to the
+ * existing library screen until the custom MH4U library UI is implemented.
+ */
+public final class MH4UHomeActivity extends Activity {
+    private static final int REQUEST_GAME_FILE = 4104;
+
+    private int dp(int value) {
+        return Math.round(value * getResources().getDisplayMetrics().density);
+    }
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+
+        gamePicker = registerForActivityResult(new ActivityResultContracts.OpenDocument(), uri -> {
+            if (uri == null) return;
+            Intent launch = new Intent(Intent.ACTION_VIEW);
+            launch.setClassName(this, "org.citra.citra_emu.activities.EmulationActivity");
+            launch.setDataAndType(uri, "application/octet-stream");
+            launch.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+            startActivity(launch);
+        });
+
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setGravity(Gravity.CENTER_VERTICAL);
+        root.setPadding(dp(28), dp(32), dp(28), dp(28));
+        root.setBackgroundColor(Color.rgb(16, 20, 29));
+
+        TextView title = new TextView(this);
+        title.setText("MONSTER HUNTER\n4 ULTIMATE");
+        title.setTextColor(Color.rgb(243, 245, 250));
+        title.setTextSize(27);
+        title.setTypeface(Typeface.DEFAULT_BOLD);
+        title.setGravity(Gravity.CENTER);
+        root.addView(title, new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        TextView subtitle = new TextView(this);
+        subtitle.setText("HUNTER'S GUILD  •  ANDROID EDITION");
+        subtitle.setTextColor(Color.rgb(155, 170, 195));
+        subtitle.setTextSize(14);
+        subtitle.setGravity(Gravity.CENTER);
+        LinearLayout.LayoutParams subtitleParams = new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        subtitleParams.topMargin = dp(10);
+        root.addView(subtitle, subtitleParams);
+
+        TextView status = new TextView(this);
+        status.setText("READY TO HUNT\n\nBackend integrated in this APK\nSelect your own legally obtained game files");
+        status.setTextColor(Color.rgb(226, 232, 240));
+        status.setTextSize(15);
+        status.setPadding(dp(18), dp(18), dp(18), dp(18));
+        status.setBackgroundColor(Color.rgb(27, 35, 49));
+        status.setGravity(Gravity.CENTER);
+        status.setLineSpacing(dp(5), 1.0f);
+        LinearLayout.LayoutParams statusParams = new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        statusParams.topMargin = dp(28);
+        root.addView(status, statusParams);
+
+        Button library = new Button(this);
+        library.setText("PILIH GAME  •  OPEN LIBRARY");
+        library.setOnClickListener(view -> {
+            Intent intent = new Intent();
+            intent.setClassName(this, "org.citra.citra_emu.ui.main.MainActivity");
+            startActivity(intent);
+        });
+        LinearLayout.LayoutParams buttonParams = new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        buttonParams.topMargin = dp(24);
+        root.addView(library, buttonParams);
+
+        Button quickLaunch = new Button(this);
+        quickLaunch.setText("PILIH FILE GAME  •  QUICK LAUNCH");
+        quickLaunch.setOnClickListener(view -> {
+            Intent pick = new Intent(Intent.ACTION_OPEN_DOCUMENT);
+            pick.addCategory(Intent.CATEGORY_OPENABLE);
+            pick.setType("*/*");
+            startActivityForResult(pick, REQUEST_GAME_FILE);
+        });
+        LinearLayout.LayoutParams quickLaunchParams = new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        quickLaunchParams.topMargin = dp(10);
+        root.addView(quickLaunch, quickLaunchParams);
+
+        setContentView(root);
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, android.content.Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (requestCode != REQUEST_GAME_FILE || resultCode != RESULT_OK || data == null) return;
+        android.net.Uri uri = data.getData();
+        if (uri == null) return;
+        Intent launch = new Intent(Intent.ACTION_VIEW);
+        launch.setClassName(this, "org.citra.citra_emu.activities.EmulationActivity");
+        launch.setDataAndType(uri, "application/octet-stream");
+        launch.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+        startActivity(launch);
+    }
+}
